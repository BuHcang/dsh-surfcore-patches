{
  "name": "dsh-surfcore-patches",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "给 SurfCore / dsh-bili-scroll 这类「独立进程」插件打本地补丁的管家：锚点补丁、版本矩阵、体检、一键回滚",
  "license": "MIT",
  "main": "lib/index.js",
  "bin": {
    "dsh-surfcore-patches": "bin/cli.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["slots"],
      "external": ["react"]
    }
  },
  "files": [
    "lib/index.js",
    "lib/engine.mjs",
    "bin/cli.mjs",
    "client.js",
    "cordis.patch.yml",
    "manifests/*.json",
    "payload/**",
    "docs/**",
    "README.md",
    "LICENSE"
  ],
  "keywords": ["dsh", "dsh-plugin", "surfcore", "patcher"],
  "engines": {
    "node": ">=22"
  }
}